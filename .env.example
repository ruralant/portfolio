# Cloudflare Turnstile keys for the /contact form.
# Create a widget at https://dash.cloudflare.com > Turnstile, then set both
# values in Netlify under Site configuration > Environment variables, keeping
# the default "All scopes": the site key is baked into the prerendered contact
# page at build time, and the secret is read by the function on each request.
#
# Leave them unset locally: `npm run dev` falls back to Cloudflare's test keys,
# which always pass, and skips the Netlify Forms hand-off.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
